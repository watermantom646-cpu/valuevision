PORT=5050
NODE_ENV=production

# Comma-separated allowed web origins for CORS, e.g. https://app.valuevision.com,https://staging.valuevision.com
ALLOWED_ORIGINS=

# Core integrations
SERPAPI_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
BRAVE_SEARCH_API_KEY=
DVLA_VEHICLE_API_KEY=
CHECKCAR_API_KEY=
DEALERPRICING_API_KEY=
DEALERPRICING_BASE_URL=
VEHICLE_STATUS_PROVIDER=dvla
CHECKCAR_URL_TEMPLATE=
# Leave blank to disable these paid enrichments:
CHECKCAR_UKVEHICLEDATA_URL_TEMPLATE=
CHECKCAR_CARHISTORY_URL_TEMPLATE=
CHECKCAR_VALUATION_URL_TEMPLATE=
CHECKCAR_USAGE_FILE=./data/checkcar-usage.json
# Launch cost protection. Set to 0 to disable limits.
CHECKCAR_DAILY_SOFT_LIMIT=200
CHECKCAR_DAILY_HARD_LIMIT=260
# GBP cost limits are checked before each provider request. Keep these enabled in production.
CHECKCAR_DAILY_SOFT_COST_LIMIT_GBP=5
CHECKCAR_DAILY_HARD_COST_LIMIT_GBP=10
CHECKCAR_SKIP_ENRICH_AT_SOFT_LIMIT=1
CHECKCAR_ENFORCE_HARD_LIMIT=1
# Monetization guardrails for paid vehicle provider data.
# PAID_ACCESS_MODE: open | token | locked
# - open: allow all vehicle provider calls
# - token: allow only requests with PAID_ACCESS_TOKEN in the paid header
# - locked: block paid vehicle provider calls unless a valid token is present
PAID_ACCESS_MODE=locked
PAID_ACCESS_TOKEN=
PAID_ACCESS_HEADER=x-valuevision-paid-token
ENFORCE_PAID_ACCESS_FOR_VEHICLE_DATA=1
PAID_ACCESS_USAGE_FILE=./data/paid-access-usage.json
# Cost model used for launch monitoring (`/provider-usage` + `launch:status`).
CHECKCAR_COST_PER_VEHICLEREG_GBP=0.02
CHECKCAR_COST_PER_UKVEHICLEDATA_GBP=0.10
CHECKCAR_COST_PER_CARHISTORY_GBP=1.82
CHECKCAR_COST_PER_VALUATION_GBP=0.12

# eBay
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_APP_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_FINDING_APP_ID=
EBAY_FORCE_FINDING=0

# Beta behaviour
BETA_STRICT_MODE=1
ACCURACY_STRICT_MODE=1
UK_PLATE_AUTO_ACCEPT_CONFIDENCE=0.86
UK_PLATE_REQUIRE_DOUBLE_MATCH=1
UK_PLATE_PROVISIONAL_LOOKUP_CONFIDENCE=0.65
UK_OCR_STATUS_LOOKUP_MAX=2

# Local caching to reduce repeated billable lookups for the same registration.
UK_STATUS_CACHE_FILE=./data/uk-status-cache.json
UK_STATUS_CACHE_TTL_MS=86400000
UK_STATUS_CACHE_STALE_TTL_MS=1209600000
UK_STATUS_CACHE_MAX_ENTRIES=20000

# Marketplace runtime tuning
MARKETPLACE_RATE_LIMIT_WINDOW_MS=60000
MARKETPLACE_RATE_LIMIT_MAX_REQUESTS=120
CHECKOUT_IDEMPOTENCY_TTL_MS=900000

# Item-analysis abuse protection. Paid plans can raise these after revenue is proven.
ITEM_ANALYZE_DAILY_HARD_LIMIT=50
ITEM_ANALYZE_PER_IP_DAILY_HARD_LIMIT=5
ITEM_ANALYZE_USAGE_FILE=./data/item-analysis-usage.json
# Web and iPhone payments. Keep all secret values on the backend only.
WEB_PAYMENTS_ENABLED=1
APPLE_PAYMENTS_ENABLED=1
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_MONTHLY_PRICE_ID=replace_with_stripe_monthly_price_id
STRIPE_CAR_CHECK_1_PRICE_ID=replace_with_stripe_single_car_check_price_id
STRIPE_CAR_CHECK_3_PRICE_ID=replace_with_stripe_three_car_checks_price_id
STRIPE_VALUATION_PRICE_ID=replace_with_stripe_valuation_price_id
PUBLIC_APP_URL=replace_with_public_valuevision_url
APPLE_ISSUER_ID=replace_with_app_store_connect_issuer_id
APPLE_KEY_ID=replace_with_app_store_connect_key_id
APPLE_PRIVATE_KEY=replace_with_app_store_connect_private_key
APPLE_BUNDLE_ID=replace_with_valuevision_bundle_id
APPLE_MONTHLY_PRODUCT_ID=ValueVision10
APPLE_CAR_CHECK_1_PRODUCT_ID=valuevision_full_car_check_1
APPLE_CAR_CHECK_3_PRODUCT_ID=valuevision_full_car_check_3
MONTHLY_SCAN_LIMIT=25
STARTER_SCAN_LIMIT=3
PAYMENT_SANDBOX_VERIFIED=0
APPLE_SANDBOX_VERIFIED=0
