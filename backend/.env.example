PORT=5050
NODE_ENV=production

# Comma-separated allowed web origins for CORS, e.g. https://app.valuevision.com,https://staging.valuevision.com
ALLOWED_ORIGINS=

# Core integrations
SERPAPI_KEY=
OPENAI_API_KEY=
DVLA_VEHICLE_API_KEY=
CHECKCAR_API_KEY=
VEHICLE_STATUS_PROVIDER=dvla
CHECKCAR_URL_TEMPLATE=
# Leave blank to disable these paid enrichments:
CHECKCAR_UKVEHICLEDATA_URL_TEMPLATE=
CHECKCAR_CARHISTORY_URL_TEMPLATE=
CHECKCAR_VALUATION_URL_TEMPLATE=
CHECKCAR_USAGE_FILE=./data/checkcar-usage.json
# Launch cost protection. Set to 0 to disable limits.
CHECKCAR_DAILY_SOFT_LIMIT=200
CHECKCAR_DAILY_HARD_LIMIT=260
CHECKCAR_SKIP_ENRICH_AT_SOFT_LIMIT=1
CHECKCAR_ENFORCE_HARD_LIMIT=1
# Monetization guardrails for paid vehicle provider data.
# PAID_ACCESS_MODE: open | token | locked
# - open: allow all vehicle provider calls
# - token: allow only requests with PAID_ACCESS_TOKEN in the paid header
# - locked: block paid vehicle provider calls unless a valid token is present
PAID_ACCESS_MODE=open
PAID_ACCESS_TOKEN=
PAID_ACCESS_HEADER=x-valuevision-paid-token
ENFORCE_PAID_ACCESS_FOR_VEHICLE_DATA=1
PAID_ACCESS_USAGE_FILE=./data/paid-access-usage.json
# Cost model used for launch monitoring (`/provider-usage` + `launch:status`).
CHECKCAR_COST_PER_VEHICLEREG_GBP=0.02
CHECKCAR_COST_PER_UKVEHICLEDATA_GBP=0.10
CHECKCAR_COST_PER_CARHISTORY_GBP=1.82
CHECKCAR_COST_PER_VALUATION_GBP=0.12

# eBay
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_APP_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_FINDING_APP_ID=
EBAY_FORCE_FINDING=0

# Beta behaviour
BETA_STRICT_MODE=1
ACCURACY_STRICT_MODE=1
UK_PLATE_AUTO_ACCEPT_CONFIDENCE=0.86
UK_PLATE_REQUIRE_DOUBLE_MATCH=1
UK_PLATE_PROVISIONAL_LOOKUP_CONFIDENCE=0.65
UK_OCR_STATUS_LOOKUP_MAX=2

# Local caching to reduce repeated billable lookups for the same registration.
UK_STATUS_CACHE_FILE=./data/uk-status-cache.json
UK_STATUS_CACHE_TTL_MS=86400000
UK_STATUS_CACHE_STALE_TTL_MS=1209600000
UK_STATUS_CACHE_MAX_ENTRIES=20000

# Marketplace runtime tuning
MARKETPLACE_RATE_LIMIT_WINDOW_MS=60000
MARKETPLACE_RATE_LIMIT_MAX_REQUESTS=120
CHECKOUT_IDEMPOTENCY_TTL_MS=900000
